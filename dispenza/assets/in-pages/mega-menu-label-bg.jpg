header#masterhead .top-bun {
    transform: rotateY(-45deg);
    display: none;
    width: 100%;
    height: 4px;
    background-color: rgba(255, 255, 255, 1);
    margin-bottom: 6px;
    transform: rotate(-45deg);
    position: relative;
}

header#masterhead .top-bun::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    width: 0%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.2);
    transition: all 0.3s cubic-bezier(0.55, 0, 0.1, 1);
}

header#masterhead .meat {
    display: none;
    width: 100%;
    height: 4px;
    background-color: rgba(255, 255, 255, 1);
    margin-bottom: 6px;
    transform: rotate(-45deg);
    position: relative;
}

header#masterhead .meat::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    width: 0%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.2);
    transition: all 0.3s cubic-bezier(0.55, 0, 0.1, 1);
}

header#masterhead .bottom-bun {
    display: none;
    width: 100%;
    height: 4px;
    background-color: rgba(255, 255, 255, 1);
    margin-bottom: 6px;
    transform: rotate(-45deg);
    position: relative;
}

header#masterhead .bottom-bun::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    width: 0%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.2);
    transition: all 0.3s cubic-bezier(0.55, 0, 0.1, 1);
}

