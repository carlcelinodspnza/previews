/* promotions gallery */
.sgPromotions-gallery {
    display: grid;
    grid-template-columns: auto auto auto;
    column-gap: 15px;
    row-gap: 15px;
}

.sgPromotions-gallery>.item {
    position: relative;
    /* padding-top: 100%; */
    background-color: #e3e3e3;
}

.sgPromotions-gallery>.item>img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
}

.sgPromotions-gallery>.item.i2 {
    grid-column: span 2;
}

.sgPromotions-gallery>.item.i3 {
    grid-column: span 3;
}

/* rep pages */
.sgRep--profile h2.name {
    line-height: 1em;
}

.sgRep--profile .thumb {
    display: block;
    text-align: center;
    margin-bottom: 25px;
}

.sgRep--profile ul.socials {
    margin-bottom: 25px;
}

.sgRep--profile ul.socials>li>a {
    width: 50px;
    height: 50px;
    line-height: 50px;
    border-radius: 50px;
    background-color: var(--sg-color-primary);
    color: #fff;
}

.sgRep--profile .ctas>a {
    margin: 2px;
}

.sgRep--profile .team-hover {
    position: relative;
    display: block;
    height: 500px;
    width: 500px;
    margin: 0 auto;
}

.sgRep--profile .team-hover img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover !important;
    object-position: top;
    transition: all 0s;
    z-index: 2;
}

.sgRep--profile .team-hover img:nth-child(2) {
    transition-delay: 0.9s;
}

.sgRep--profile .team-hover img:nth-child(3) {
    transition-delay: 0.6s;
}

.sgRep--profile .team-hover img:nth-child(4) {
    transition-delay: 0.30s;
}

.sgRep--profile .team-hover:hover img:nth-child(2) {
    transition-delay: 0.30s;
}

.sgRep--profile .team-hover:hover img:nth-child(3) {
    transition-delay: 0.6s;
}

.sgRep--profile .team-hover:hover img:nth-child(4) {
    transition-delay: 0.9s;
}

.sgRep--profile .team-hover img+img {
    opacity: 0;
}

.sgRep--profile .team-hover:hover img+img {
    opacity: 1;
}

.sgBookDemo--section {
    color: #fff;
    background: rgb(176, 39, 208);
    background: linear-gradient(0deg, rgba(176, 39, 208, 1) 0%, rgb(36 1 44) 100%);
}

.sgRep--fancyB {
    display: none;
    max-width: 700px;
    width: 100%;
    padding: 35px;
}

.sgRepListings {
    display: flex;
    flex-wrap: wrap;
}

.sgRepListings>.item {
    flex: 0 0 calc(calc(100% / 3) - 30px);
    max-width: calc(calc(100% / 3) - 30px);
    margin: 15px;
}

.sgRepListings>.item>.info {
    padding: 25px;
    background-color: #fff;
    box-shadow: 0px 0px 10px 0px rgba(232, 225, 232, 1);
}

.sgRepListings>.item .details>h3 {
    font-weight: bold;
    text-transform: uppercase;
    line-height: 1em;
    font-size: 26px;
    font-weight: 900;
    margin: 15px 0;
}

