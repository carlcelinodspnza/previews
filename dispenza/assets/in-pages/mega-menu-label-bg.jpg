        max-width: 150px;
    }
}.section-live {
    list-style: none;
}

.section-live li:nth-child(odd) {
    color: white;
    text-shadow: -1px -1px 0 black,
        /* Top left */
        1px -1px 0 black,
        /* Top right */
        -1px 1px 0 black,
        /* Bottom left */
        1px 1px 0 black;
}

.section-live li {
    position: relative;
    font-size: 152.79px;
    line-height: normal;
    text-transform: uppercase;
    font-weight: 600;
    margin: 0px 70px 0px 70px;
    color: #8D3FE8;
}


