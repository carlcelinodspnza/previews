.sg-section-case-studies-tcg-more-case-studies .case-card>.wrap>.info>.details>.loc {
    position: relative;
    display: block;
    font-weight: 300;
    line-height: 1.25em;
}

.sg-section-case-studies-tcg-more-case-studies .case-card>.wrap>.info>.details>h5 {
    font-weight: bold;
    font-size: 24px;
}

.page-home .sg-section-case-studies-tcg-more-case-studies .case-card>.ctas a:before {
    content: none;
}

.sg-section-case-studies-tcg-more-case-studies .case-card>.ctas .btn {
    font-family: 'Montserrat';
    --bs-btn-padding-x: 25px;
    --bs-btn-padding-y: 15px;
    border-radius: 5px;
    border-width: 2px;
    font-weight: 600;
    transition: all 0.3s ease-in-out;
    font-size: 1rem;
    padding: 20px 5px;

}

.sg-section-case-studies-tcg-more-case-studies .case-card>.ctas .btn-primary {
    --bs-btn-color: #fff;
    --bs-btn-bg: #8B3EE6;
    --bs-btn-border-color: #8b3fe1;
    --bs-btn-hover-color: #fff;
    --bs-btn-hover-bg: #842de8;
    --bs-btn-hover-border-color: #8229e7;
    --bs-btn-focus-shadow-rgb: 49, 132, 253;
    --bs-btn-active-color: #fff;
    --bs-btn-active-bg: #7621d7;
    --bs-btn-active-border-color: #7a31cd;
    --bs-btn-active-shadow: inset 0 3px 5px rgba(0, 0, 0, 0.125);
    --bs-btn-disabled-color: #fff;
    --bs-btn-disabled-bg: #8b15a6;
    --bs-btn-disabled-border-color: #8b15a6;
}



/* End More Cast Studies */

/** Footer **/
footer#masterfoot {
    /*background-image: url(https://dispenza.com/sites/sg_dispenza-7/uploads/2023/10/footer_bg2.webp);*/
    /*background-repeat: no-repeat;*/
    /*background-size: cover;*/
}

footer#masterfoot .widget-image {
    max-width: 80%;
}

footer#masterfoot .fa-brands {
    background-color: #1c1e22;
    color: #8b8d91 !important;
    display: block;
    margin: 0 auto;
    width: 40px;
    height: 40px;
    color: #fff;
    border-radius: 40px;
    text-align: center;
    line-height: 40px;
}

.footer-site-brand {
    width: 50%;
}

/** End Footer **/

/** Top Footer **/
footer#masterfoot {
    margin-top: 155px;
}

footer#masterfoot .cta-row {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 75px 50px;
    background-image: url(/sites/sg_dispenza-7/uploads/2024/01/cta_bg.webp);
    background-repeat: no-repeat;
    background-size: cover;
    background-position: bottom left;
    color: #fff;
    letter-spacing: 0;
    border-radius: 10px;
    max-width: 1200px;
    margin: 0 auto;
    margin-bottom: 0px;
}

footer#masterfoot .cta-row>.info {
    flex: 0 0 60%;
    max-width: 60%;
    padding-right: 25px;
    letter-spacing: 0;
}

footer#masterfoot .cta-row h2.fw-bold {
    font-weight: 900 !important;
}

footer#masterfoot .cta-row h2 {
    font-size: 43px;
    line-height: 1em;
    font-weight: 700;
}

footer#masterfoot .cta-row>.ctas {
    flex: 0 0 40%;
    max-width: 40%;
    text-align: center;
}

footer#masterfoot .sg-section_ctas a {
    padding: 29px 84px !important;
    font-size: 26px !important;
}

footer#masterfoot .sg-section_ctas .text {
    font-weight: 600;
}

footer#masterfoot .section-footer-top {
    padding-top: 130px;
}

/** End Top Footer **/

