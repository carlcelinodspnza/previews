<!-- Custom Code Block: Conversion | Step Form Scripts (body_end) -->
<script>
    $(document).on(
        'change',
        'form.sgsc--myform.sgsc--myform-3 select[name="time_to_talk"]',
        function() {
            const $select = $(this);
            const $form = $select.closest('form.sgsc--myform');
            const val = ($select.val() || '').trim();

            if (val !== 'Choose Date & Time') {
                $form.removeData('redirectAfterSubmit').removeData('redirectUrl');
                return;
            }

            const ok = window.confirm("We’ll take you to the booking page to pick a date/time. Continue?");
            if (!ok) {
                $select.val('As soon as possible').trigger('change');
                $form.removeData('redirectAfterSubmit').removeData('redirectUrl');
                return;
            }

            // --- helpers (by field name) ---
            const readByName = (fieldName) => {
                const $el = $form.find(`[name="${fieldName}"]`).first();
                return $el.length ? ($el.val() || '').trim() : '';
            };

            // Build redirect URL NOW (before submit) and stash it
            const buildRedirectUrl = () => {
                const REDIRECT_BASE = 'https://dispenza.com/request-a-demo';
                const data = {
                    firstName: readByName('first_name'),
                    lastName: readByName('last_name'),
                    email: readByName('email'),
                    phone: readByName('phone_number'),
                    company: readByName('dispensary_name')
                };

                const params = new URLSearchParams();
                Object.keys(data).forEach(k => {
                    if (data[k]) params.set(k, data[k]);
                });
                params.set('source', 'form');
                params.set('intent', 'book_demo');

                return params.toString() ? `${REDIRECT_BASE}?${params.toString()}` : REDIRECT_BASE;
            };

            $form.data('redirectAfterSubmit', true);
            $form.data('redirectUrl', buildRedirectUrl());

            // Submit the form. Use trigger to respect validators.
            $form.trigger('submit');
        }
    );

    // After the form actually submits successfully
    $(document).on('form_submitted', 'form.sgsc--myform.sgsc--myform-3', function() {
        const $form = $(this);
        if (!$form.data('redirectAfterSubmit')) return;

        const url = $form.data('redirectUrl') || 'https://dispenza.com/request-a-demo';

        // Optional: small delay to let analytics fire; or use location.replace to avoid back nav.
        // setTimeout(() => { window.location.replace(url); }, 150);
        window.location.href = url;

        // Clean up flags
        $form.removeData('redirectAfterSubmit').removeData('redirectUrl');
    });
</script>
<!-- /Custom Code Block: Conversion | Step Form Scripts -->

        
