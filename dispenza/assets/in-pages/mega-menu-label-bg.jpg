.suite-detail-item {
    cursor: pointer;
    padding-left: 1em !important;
    /* padding-right: 1em !important; */
}

.title-muted {
    color: #7858A2
}

.page-case-studies .owl-controllers {
    display: none;
}

.text-gold {
    color: #fbc02d !important;
}

/* Performance Marketing */
.page-how-it-works h1 {
    font-size: 100px;
    font-weight: 900;
    line-height: 90px;
    /*color: #781be4 !important;*/
}

.sg-section-page-banner h1 {
    font-size: 50px;
    line-height: normal;
}

@media screen and (max-width:992px) {

    .sg-section-page-banner h1,
    .page-how-it-works h1 {
        font-size: 70px;
        line-height: normal;
    }
}

@media only screen and (max-width: 767px) {

    .sg-section-page-banner h1,
    .page-how-it-works h1 {
        font-size: 50px;
        line-height: normal;
    }
}

@media only screen and (max-width: 575px) {

    .sg-section-page-banner h1,
    .page-how-it-works h1 {
        font-size: 34px;
    }
}

.sg-section-page-banner p {
    color: #781be4 !important;
}

.sg-section-342a638455324 {
    padding-top: 100px;
}

.sg-section_content {
    font-size: 21px;
}

.sg-section-page-banner .sg-inner-container {
    /*width: 40%;*/
}

.sg-section_title h4 {
    font-weight: 900;
    font-size: 30px;
    letter-spacing: 1px;
    font-family: 'Montserrat';
}


.sg-section_title h5 {
    font-size: 22px;
    line-height: 1.75em;
    font-weight: 400;
    letter-spacing: 1px;
}

.sg-section-our-suite-cro {
    padding-top: 0;
}

.page-performance-marketing .sgen--cards .card-item-content,
.page-conversion-rate-optimization .sgen--cards .card-item-content,
.page-ads-design .sgen--cards .card-item-content,
.page-consulting .sgen--cards .card-item-content,
.page-webdesign-development .sgen--cards .card-item-content,
.page-integrations .sgen--cards .card-item-content,
.page-branding-graphic-design .sgen--cards .card-item-content {
    position: relative;
    padding: 20px;
    border-radius: 15px;
    border: 1px solid var(--sg-color-primary);
    box-shadow: -20px 10px 24px -8px grey;
    margin: 15px;
}

.page-performance-marketing .sgen--cards .card-item-content h5,
.page-conversion-rate-optimization .sgen--cards .card-item-content h5,
.page-ads-design .sgen--cards .card-item-content h5,
.page-consulting .sgen--cards .card-item-content h5,
.page-webdesign-development .sgen--cards .card-item-content h5,
.page-integrations .sgen--cards .card-item-content h5,
.page-branding-graphic-design .sgen--cards .card-item-content h5 {
    font-weight: 900 !important;
    font-size: 21px;
    text-transform: none !important;
}

.page-performance-marketing .sgen--cards .card-item-content .card-content,
.page-conversion-rate-optimization .sgen--cards .card-item-content .card-content,
.page-ads-design .sgen--cards .card-item-content .card-content,
.page-consulting .sgen--cards .card-item-content .card-content,
.page-webdesign-development .sgen--cards .card-item-content .card-content,
.page-integrations .sgen--cards .card-item-content .card-content,
.page-branding-graphic-design .sgen--cards .card-item-content .card-content {
    font-size: 19px;
    margin-bottom: 0;
    line-height: 27px;
    font-weight: 400;
    letter-spacing: 1px;
}

.page-performance-marketing .sg-section-2-columns .sg-inner-row {
    display: flex;
    flex-direction: row-reverse;
}

/* End Performance Marketing */

/* Consulting */
.page-consulting .sg-section-e3a6348ac51e5 .sg-section_content b {
    font-weight: 900;
    font-family: 'Montserrat';
}

.page-consulting .sg-section-e3a6348ac51e5 .sg-section_content {
    font-size: 30px;
    font-weight: normal !important;
