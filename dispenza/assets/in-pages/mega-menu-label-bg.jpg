.marquee-container {
    overflow: hidden;
    white-space: nowrap;
    width: 100%;
}

.marquee-content {
    display: flex;
    white-space: nowrap;
    animation: marquee 50s linear infinite;
    width: 100%;
    overflow: initial;
}

@keyframes marquee {
    0% {
        transform: translateX(0%);
    }

    100% {
        transform: translateX(-100%);
    }
}
@media screen and (min-width:768px) and (max-width:1700px) {
    .marquee-content li {
        font-size: 80px;
        line-height: 90px;
    }
}
@media screen and (max-width:767px) {
    .marquee-content {
        animation: marquee 20s linear infinite;
    }

