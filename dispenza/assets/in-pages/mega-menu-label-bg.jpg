/*}*/

/* Mobile Nav */
#mobile-nav>.inner {
    width: 100%;
    background-color: #000;
    background-image: url(/sites/sg_dispenza-7/uploads/2024/01/mobile_slideout_popout_bg.webp);
    background-repeat: no-repeat;
    background-size: cover;
}

#mobile-nav .close {
    top: 20px;
    right: 10px;
    left: auto;
}

#mobile-nav .brand {
    position: absolute;
    width: 65%;
    top: 12px;
    left: 12px;
}

#mobile-nav .brand .site-img-logo {
    width: 250px;
}

header#masterhead .mobile-toggler-burger {
    width: 50px;
    height: 50px;
    background-image: url(/sites/sg_dispenza-7/uploads/2024/01/Screenshot_2023_11_03_at_2_31_10_PM.webp);
    background-size: 120%;
}

.mobile-toggler-burger {
    background-color: transparent;
}

/* End Mobile Nav */

/* Mega Menu */
header#masterhead .navbar-nav .dropdown-menu.mega-menu-dropdown {
    margin-top: 34px;
    background-color: #222429;
}

header#masterhead .navbar-nav .dropdown-menu.mega-menu-dropdown section {
    background-color: #fff;
}

.mega-menu-title {
    background-image: url(/sites/sg_dispenza-7/uploads/2024/01/mega_menu_label_bg.webp);
}

.mega-menu-title span {
    letter-spacing: 2px;
}

.mega-menu-dropdown section {
    padding-top: 0;
    padding-bottom: 0;
}

.mega-menu-dropdown .row>* {
    padding-left: 0;
    padding-right: 0;
}

.mega-menu-dropdown .mega-menu-links .mega-menu-link a img {
    width: 60px;
    height: 60px;
    object-fit: contain;
    object-position: center;
    border-radius: 10px;
    margin-right: 10px;
}

.mega-menu-dropdown .suite-details .suite-detail-item {
    display: flex;
    flex-wrap: nowrap;
    flex-direction: row;
    align-items: flex-start;
    flex: 0 0 calc(50% - 30px);
    max-width: calc(50% - 30px);
    border: 1px solid transparent;
}


.mega-menu-dropdown img {
    width: 55%;
    height: 60%;
}


.mega-menu-dropdown h5 {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.2em;
}

.mega-menu-dropdown p {
    font-size: 14px;
    line-height: 19px;
}

.mega-menu-dropdown .mega-menu-link a:hover {
    text-decoration: none !important;
    box-shadow: 0px 0px 10px 0px rgba(232, 225, 232, 1);
}

.mega-menu-dropdown .mega-menu-link span {
    color: #000;
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
}

.navbar-nav .nav-item.is-mega-menu>.dropdown-menu {
    width: 100%;
    max-width: 1800px;
    margin: 0 auto;
    overflow: hidden;
}

.mega-menu-dropdown .mega-menu-links .row {
    /* margin-bottom: 50px; */
}

.mega-menu-link>a {
    position: relative;
    display: flex;
    align-items: center;
    padding: 15px;
}

.mega-menu-link>a:hover {
    /* left: -15px;
  border-radius: 12px;
  -webkit-box-shadow: 0px 0px 10px 0px rgba(232,225,232,1);
  -moz-box-shadow: 0px 0px 10px 0px rgba(232,225,232,1);
  box-shadow: 0px 0px 10px 0px rgba(232,225,232,1); */
}

.is-mega-menu>a:hover {
    background-color: unset;
}

.mega-menu-link a span:hover {
    text-decoration: none;
}


.suite-detail-item:hover {
    background-color: #fff;
    border: 1px solid #fff;
    border-radius: 10px;
    left: -15px;
    top: 10px;
    -webkit-box-shadow: 0px 0px 10px 0px rgba(232, 225, 232, 1);
    -moz-box-shadow: 0px 0px 10px 0px rgba(232, 225, 232, 1);
    box-shadow: 0px 0px 10px 0px rgba(232, 225, 232, 1);
    box-shadow: 0px 0px 10px 0px rgba(232, 225, 232, 1);
    transform: translateX(50);
    text-decoration: none;
    padding-top: 10px;
}

.suite-detail-items {
    max-height: 250px;
}


