/* ++++++++++++++++++++++++++++++++++++++++++++++++++   BUTTON CSS  
+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++*/

/* IMGAE WITH BUTTON */
.btn {
    font-weight: 700;
    border-width: 1px !important;
}

.btn.btn-primary,
.btn.btn-accent,
.btn.btn-dark {
    height: 70px;
    background: linear-gradient(to right, #420F7B 9%, #8D3FE8 100%) !important;
    border: 0px;
    min-width: 277px;
}

.btn.btn-secondary,
.btn.btn-success {
    height: 70px;
    min-width: 277px;
}

.btn.btn-info {
    height: 70px;
    min-width: 242px;
    border-radius: 0px;
}

@media screen and (max-width:768px) {

    /*.sticky-mobile-ctas {*/
    /*    gap: 20px;*/
    /*    background-color: transparent;*/
    /*    justify-content: center;*/
    /*    padding: 10px;*/
    /*    display: none;*/
    /*}*/

    /*.show {*/
    /*    display: flex !important;*/
    /*}*/

    .btn.btn-primary,
    .btn.btn-secondary,
    .btn.btn-success,
    .btn.btn-accent,
    .btn.btn-dark {
        min-width: 230px;
        font-size: 20px;
    }

    .sticky-mobile-ctas>a.btn {
        min-width: 230px;
        flex: none;
        height: 56px;
        font-size: 20px;
        font-weight: 600;
        text-transform: none !important;
        box-shadow: none;
    }

    .sticky-mobile-ctas>a.btn.btn-warning {
        border: 1px solid #8d3fe8;
    }
}

@media screen and (max-width:500px) {

    .btn.btn-primary,
    .btn.btn-accent,
    .btn.btn-dark,
    .btn.btn-secondary,
    .btn.btn-success,
    .sticky-mobile-ctas>a.btn {
        min-width: 155px;
        height: 50px;
        font-size: 16px;
        padding: 0px;
    }

    .btn.btn-info {
        height: 53.22px;
        min-width: 184px;
        font-size: 18px;
        border-radius: 0px;
    }
}

/* ++++++++++++++++++++++++++++++++++++++++++++++++++   BUTTON CSS  END
+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++*/

/* ++++++++++++++++++++++++++++++++++++++++++++++++++   HEADER CSS  
+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++*/
header#masterhead {
    position: absolute;
    width: 100%;
    top: 25px;
    background-color: transparent;
    box-shadow: none;
}

header#masterhead.sticky {
    background-color: #000 !important;
    transition: background-color 1s ease 0s;
}

.dropdown-item:focus,
.dropdown-item:hover {
    background-color: transparent;
}

.dropdown-menu {
    min-width: max-content;
    padding: 18px;
    background: #781be4;
    color: white;
}

.dropdown-menu .nav-item {
    margin-bottom: 15px;
}

@media screen and (min-width: 1400px) {
    header#masterhead .primary-navbar .container {
        max-width: 1760px;
        padding: 0px 40px;
    }

}

@media screen and (max-width:1399px) {
    header#masterhead .primary-navbar .container {
        max-width: 1250px;
        padding: 0px 0px;
    }
}

header#masterhead .navbar-wrapper .navbar-brand,
.footer-widget-item--image .widget-image img {
    max-width: 277px;
    flex: 0 0 277px;
}

header#masterhead.sticky {
    background-color: #0b1335;
    padding: 7px 0px;
}

header#masterhead .sg-site-navigation.navbar-nav>.nav-item {
    padding: 0px;
    margin-right: 45px;
}

header#masterhead .sg-site-navigation.navbar-nav .nav-link {
    padding: 0px;
    font-size: 25px;
    font-weight: 500;
    text-align: left;
    /*use only dropdown*/

}

header#masterhead .navbar-light .navbar-nav .nav-link:focus,
.navbar-light .navbar-nav .nav-link:hover {
    color: inherit;
}

header#masterhead .navbar-ctas {
    align-items: center;
    column-gap: 60px;
}

header#masterhead .navbar-ctas>.nav-cta-item {
    padding: 0px;
}

header#masterhead .navbar-ctas>.nav-cta-item .btn-default.btn-has-icon {
    background-color: transparent;
    border: 0px;
    border-radius: 0px;
    padding: 0px;
    margin: 0px !important;
}

header#masterhead .navbar-ctas>.nav-cta-item .btn-default.btn-has-icon .icon {
    margin-right: 0px;
    position: relative;
    visibility: hidden;
    width: 100%;
}

header#masterhead .navbar-ctas>.nav-cta-item .btn-default.btn-has-icon .icon .fa-phone {
    visibility: hidden;
}

header#masterhead .navbar-ctas>.nav-cta-item .btn-default.btn-has-icon .icon::before {
    visibility: visible;
    content: '';
    position: absolute;
    top: 0;
    background-image:url('https://dispenza.com/sites/sg_dispenzasgen_seogstage/uploads/2024/11/Vector__5_.webp');
    background-repeat: no-repeat;
    background-size: contain;
    background-position: center;
    width: 31px;
    height: 30px;
    margin: 0px auto;
    bottom: 0px;
}

header#masterhead .navbar-ctas>.nav-cta-item .btn-default.btn-has-icon .text {
    display: none;
}

@media screen and (min-width:1250px) and (max-width:1700px) {
    header#masterhead .sg-site-navigation.navbar-nav .nav-link {
        font-size: 18px;
    }
}

@media screen and (max-width:768px) {
    header#masterhead .primary-navbar .navbar {
        padding: 0px 37px;
    }
}

@media (max-width: 1280px) {

    .navbar-expand-md {
        justify-content: space-between;
    }

    .mobile-toggler-burger,
    .mobile-navbar-brand {
        display: block;
    }

    header#masterhead .navbar-wrapper {
        display: none;
    }

    header#masterhead .navbar {
        padding: 10px 50px !important;
    }
}

/* ++++++++++++++++++++++++++++++++++++++++++++++++++   HEADER CSS  END
+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++*/

header#masterhead .navbar-nav>.nav-item {
    padding: 35px 5px;
}

/* home hero section */
.sg-section.home-hero {
    position: relative;
    display: flex;
    align-items: center;
    background-color: transparent;
    color: #fff;
    min-height: calc(96vh - 100px);
}

.sg-section.home-hero .sg-inner-row {
    align-items: center;
}

.sg-section.home-hero .sg-inner-row>.sg-grid-1 {
    padding: 70px 50px 50px 70px;
}

.sg-section.home-hero .sg-section_title>.t {
    font-weight: 900;
    color: #fff;
    line-height: 1em;
}

.sg-section.home-hero .sg-section_content {
    /*display: none;*/
}

.sg-section.home-hero:before {
    height: 200%;
}

.sg-section.home-hero+.sg-section {
    padding-top: 300px;
}

.sg-section.home-hero>.sg-inner-container {
    max-width: 1300px;
}

.sg-section.home-hero>.sg-inner-container>.sg-inner-row>.sg-grid-1 {
    width: 45%;
}

.sg-section.home-hero>.sg-inner-container>.sg-inner-row>.sg-grid-2 {
    width: 55%;
}

/* highlights section */
.sg-section.highlights-section .sg-section_title>.t {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
}

.sg-section.highlights-section .sgen--cards .card-item>.card-item-content {
    padding: 50px 20px;
    border-radius: 15px;
}

.sg-section.highlights-section .sgen--cards .card-item>.card-item-content .card-title>.t {
    font-weight: 900;
    font-size: 50px;
}

.sg-section.highlights-section .sgen--cards .card-item>.card-item-content .card-title>.st {
    font-size: 12px;
    font-weight: 200;
    letter-spacing: 2px;
}

.sg-section.highlights-section .sg-section_title {
    padding: 0 15px;
}

.sg-section.highlights-section .t {
    font-size: 80px;
}

/* Features Section */
.highlights-section .sg-section_title {
    margin-bottom: 40px;
}

/* results section */
.sg-section.results-section .sgen--cards .card-item {
    pointer-events: none;
    /* disable link and hover */
}

.sg-section.results-section .sgen--cards .card-item>.card-item-content {
    /*border-radius: 15px;*/
}

.sg-section.results-section .sgen--cards .card-item>.card-item-content .card-title>.t {
    font-size: 16px;
}

.sg-section.results-section .sgen--cards .card-item>.card-item-content .card-content>p {
    font-size: 24px;
    line-height: 1em;
    font-weight: bold;
    margin-bottom: 5px;
}

.sg-section.results-section .sgen--cards .card-item>.card-item-content .card-content>p:last-of-type {
    font-size: 16px;
    font-weight: normal;
    letter-spacing: 2px;
}

.sg-section.results-section .sgen--cards .card-item>.card-item-content .card-content>p:last-of-type b {
    display: inline-block;
    width: 25px;
    height: 25px;
    line-height: 25px;
    background-color: #fff;
    color: #000;
}

.sg-section.results-section .sgen--cards .card-item>.card-item-content .card-content>h4 {
    font-size: 42px;
    font-weight: 900;
    line-height: 1em;
}

.sg-section.results-section .sgen--cards .card-item>.card-item-content {
    background-image: url() !important;
    background-color: transparent !important;
    color: inherit !important;
    padding: 0;
    box-shadow: none;
}

.sg-section.results-section .sgen--cards .card-item>.card-item-content .card-title {
    height: 25px;
    text-align: center;
    white-space: nowrap;
}

.sg-section.results-section .sgen--cards .card-item>.card-item-content .card-content {
    text-align: center;
    color: #ffffff;
    background-color: #000000;
    background-image: url(https://dispenza.com/sites/sg_dispenza-7/uploads/2023/10/card_results_bg.webp);
    box-shadow: rgba(0, 0, 0, 0.5) 0px 4px 12px;
    padding: 25px;
    border-radius: 15px;
    backface-visibility: hidden;
    transition: all 0.35s;
}

.sg-section.results-section .sgen--cards .card-item>.card-item-content .card-ctas {
    display: flex;
    align-items: center;
    position: absolute;
    top: 25px;
    bottom: 0;
    right: 0;
    left: 0;
    background-color: #000000;
    background-image: url(https://dispenza.com/sites/sg_dispenza-7/uploads/2023/10/card_results_bg.webp);
    box-shadow: rgba(0, 0, 0, 0.5) 0px 4px 12px;
    padding: 15px;
    border-radius: 15px;
    backface-visibility: hidden;
    transform: rotateY(180deg);
    transition: all 0.35s;
}

.sg-section.results-section .sgen--cards .card-item>.card-item-content .card-ctas .btn {
    width: 100%;
}

.sg-section.results-section .sgen--cards .card-item:hover>.card-item-content .card-content {
    transform: rotateY(180deg);
}

.sg-section.results-section .sgen--cards .card-item:hover>.card-item-content .card-ctas {
    transform: rotateY(0);
}

.sgen--cards .card-ctas a.btn {
    min-width: 100%;
}


body,
footer#masterfoot h1,
h2,
h3,
h4,
h5,
h6 {
    font-family: 'Montserrat' !important;
    line-height: 1.75em;
}

.site-wrapper {
    /*background-image: url(https://dispenza.com/sites/sg_dispenza-7/uploads/2023/10/footer_bg2.webp);
  background-position: bottom;
  background-repeat: no-repeat;
  /*background-size: 150%;*/
}

.site-content {
    background: none;
}

/* our suite */
.our-suite-detail-item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    color: #1C1C1E;
    color: var(--sg-color-primary);
    padding: 10px;
    border: 1px solid transparent;
    max-width: 220px;
    padding: 25px;
    margin: 0 auto;
    height: 100%;
}

.our-suite-detail-item .title {
    font-size: 16px;
    font-weight: bold;
    text-align: center;
    color: #000;
    letter-spacing: 0;
    margin-top: 5px;
    line-height: 1em;
}

.our-suite-detail-item span.readmore {
    display: block;
    font-weight: bold;
    font-size: 12px;
    line-height: 1em;
    letter-spacing: 2px;
    background-color: var(--sg-color-primary);
    color: #fff;
    text-transform: uppercase;
    padding: 7px 15px;
    border-radius: 8px;
    margin-top: auto;
    opacity: 0;
    transition: all 0.35s;
}

.our-suite-detail-item:hover span.readmore {
    opacity: 1;
}

.sg-section.sg-section-354c65747e406 {
    background-position-x: -5vw;
}

/* suite card item */
.suite-card-item {
    display: flex;
    color: #000;
    margin-bottom: 15px;
    /* padding: 25px; */
    /* font-size: 15px; */
    line-height: 1.5em;
    border-radius: 15px;
    transition: all 0.35s;
}

.suite-card-item:hover {
    -webkit-box-shadow: -12px 6px 18px 0px rgba(232, 225, 232, 1);
    -moz-box-shadow: -12px 6px 18px 0px rgba(232, 225, 232, 1);
    box-shadow: -12px 6px 18px 0px rgba(232, 225, 232, 1);
    transform: translate(12px, -12px);
    background-color: #F3F4F8;
}

.suite-card-item>.thumb {
    flex: 0 0 150px;
}

.suite-card-item>.content>h5 {
    font-size: 26px;
    font-weight: 600;
    margin-bottom: .5rem;
    line-height: 1.2;
}

.suite-card-item>.content p {
    font-size: 15px;
}


/* case studies */
.case-studies-items {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    width: 100%;
}

.case-studies-items .article-item {
    position: relative;
    font-family: 'Montserrat';
    max-width: 100%;
    margin: 0;
}

.case-studies-items>.article-item {
    flex: 0 0 50%;
    max-width: 50%;
    padding: 15px;
}

.case-studies-items .article-item>.article-logo {
    position: absolute;
    width: 100%;
    height: 130px;
    top: 0;
    left: 0;
    padding: 10px;
}

.case-studies-items .article-item>.article-logo img {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    transform: translateY(-50%);
    margin: 0 auto;
    max-width: 100%;
    max-height: 100%;
}

.case-studies-items .article-item>.article-logo~.wrap {
    margin-top: 120px;
}

.case-studies-items .article-item>.wrap>.info {
    top: auto;
    bottom: 0;
    transform: none;
    display: none;
}

/* case card */
.case-card {
    position: relative;
    max-width: 400px;
    margin: 0 auto;
}

.case-card>.wrap {
    position: relative;
    display: block;
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    background-color: #000;
    height: 350px;
    border-radius: 5px;
    transition: all 0.35s;
    overflow: hidden;
}

.case-card>.wrap>a.p {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 22;
}

.case-card>.wrap>.thumb {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.case-card>.wrap>.thumb>img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: all 5s;
}

.case-card:hover>.wrap>.thumb>img {
    transform: scale(1.1);
}

.case-card>.wrap>.info {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    transform: translateY(-50%);
    text-align: center;
    padding: 25px;
    transition: all 0.35s;
    z-index: 1;
}

.case-card>.wrap>.info>.article-logo {
    margin-bottom: 15px;
}

.case-card>.wrap>.info>.article-logo img {
    max-width: 200px;
    max-height: 100px;
    margin: 0 auto;
}

.case-card>.wrap>.info>.details {
    background-color: #222429;
    color: #fff;
    text-align: left;
    padding: 15px;
    border-radius: 5px;
    overflow: hidden;
}

.case-card>.wrap>.info>.details>.loc {
    position: relative;
    display: block;
    font-weight: 300;
    line-height: 1.25em;
}

.case-card>.wrap>.info>.details>.loc:after {
    content: '';
    position: absolute;
    display: inline-block;
    width: 60px;
    height: 2px;
    background-color: var(--sg-color-primary);
    top: 50%;
    margin-left: 15px;
    transform: translateY(-50%);
}

.case-card>.wrap>.info>.details>h5 {
    font-weight: bold;
    font-size: 24px;
}

.case-card>.ctas {
    display: block;
    margin-top: 15px;
    text-align: center;
}

.case-card:not(:hover)>.wrap>.thumb,
.case-card:not(:hover)>.wrap>.info {
    filter: grayscale(100%);
}

.case-card:hover>.wrap>.thumb+.info {
    display: block !important;
}

.case-card.sm>.wrap>.info>.details {
    font-size: 14px;
    line-height: 1.25em;
}

.case-card.sm>.wrap>.info>.details>h5 {
    font-size: 18px;
}

.card-item>.card-item-content .card-content>p:last-of-type b {
    position: relative;
    display: inline-block;
    width: 25px;
    height: 25px;
    background-color: #fff;
    text-align: center;
    line-height: 25px;
    color: #51357d;
    font-size: 14px;
    font-weight: bold;
}

.card-item>.card-item-content .card-content>p:last-of-type b:before {
    content: '';
    position: absolute;
    top: 1px;
    left: 1px;
    width: calc(100% - 2px);
    height: calc(100% - 2px);
    border: 1px solid #51357d;
}



