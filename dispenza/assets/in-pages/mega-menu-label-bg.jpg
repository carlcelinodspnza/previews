<script>
    // accesibility

    document.addEventListener("DOMContentLoaded", function() {
        // Add role="button" to non-button elements
        const nonButtonSelectors = "a, span, div";
        document.querySelectorAll(nonButtonSelectors).forEach(element => {
            const isButtonLike = element.getAttribute("role") === "button" || element.className.includes("btn");
            if (isButtonLike && element.tagName !== "BUTTON") {
                element.setAttribute("role", "button");

                // Ensure keyboard accessibility with tabindex
                if (!element.hasAttribute("tabindex")) {
                    element.setAttribute("tabindex", "0");
                }

                // Ensure an aria-label exists if the element lacks descriptive text
                if (!element.textContent.trim() && !element.hasAttribute("aria-label")) {
                    const className = element.className || "button-like element";
                    element.setAttribute("aria-label", `Interactive ${className.replace(/btn|-/g, " ").trim()}`);
                }
            }
        });


    });

    function enhanceHeadings() {
        // Select all elements that visually function as headings
        document.querySelectorAll(".title").forEach(element => {
            // Add role="heading" if the element is not already a heading tag
            if (!/^H[1-6]$/i.test(element.tagName)) {
                element.setAttribute("role", "heading");

                // Optionally specify a heading level (e.g., level 2 by default)
                element.setAttribute("aria-level", "2");
            }
        });
    }

    // Run the function on page load
    document.addEventListener("DOMContentLoaded", enhanceHeadings);


    function enhanceMenuAccessibility() {
        // Select all menu items with dropdowns
        document.querySelectorAll('.nav-link.dropdown-item').forEach(menuItem => {
            // Add aria-haspopup="true" to indicate the presence of a dropdown
            if (!menuItem.hasAttribute("aria-haspopup")) {
                menuItem.setAttribute("aria-haspopup", "true");
            }

            // Add aria-expanded="false" by default if not already present
            if (!menuItem.hasAttribute("aria-expanded")) {
                menuItem.setAttribute("aria-expanded", "false");
            }

            // Listen for click or hover to toggle aria-expanded
            menuItem.addEventListener("click", function(event) {
                // Prevent default behavior if necessary
                event.preventDefault();

                // Get the current state
                const isExpanded = menuItem.getAttribute("aria-expanded") === "true";

                // Toggle aria-expanded state
                menuItem.setAttribute("aria-expanded", !isExpanded);

                // Optionally handle showing/hiding dropdown here
                const dropdown = menuItem.nextElementSibling; // Assumes the dropdown is the next sibling
                if (dropdown && dropdown.classList.contains("dropdown-menu")) {
                    dropdown.style.display = isExpanded ? "none" : "block"; // Toggle visibility
                }
            });

            // (Optional) Handle closing the dropdown on outside click
            document.addEventListener("click", function(event) {
                if (!menuItem.contains(event.target)) {
                    menuItem.setAttribute("aria-expanded", "false");
                    const dropdown = menuItem.nextElementSibling;
                    if (dropdown && dropdown.classList.contains("dropdown-menu")) {
                        dropdown.style.display = "none";
                    }
                }
            });
        });
    }

    // Run the function on page load
    document.addEventListener("DOMContentLoaded", enhanceMenuAccessibility);


    function enhanceImageAccessibility() {
        const images = document.querySelectorAll('img');

        images.forEach(img => {
            // Check if the image already has an alt attribute
            if (!img.hasAttribute('alt') || img.getAttribute('alt').trim() === '') {
                // Assign a default alt text based on context
                const src = img.getAttribute('src');
                if (src) {
                    const filename = src.split('/').pop().split('.')[0].replace(/[_-]/g, ' ');
                    img.setAttribute('alt', `Image of ${filename}`);
                } else {
                    img.setAttribute('alt', 'Decorative image');
                }
            }
        });
    }

    // Run on page load
    document.addEventListener('DOMContentLoaded', enhanceImageAccessibility);


    function handleDecorativeElements() {
        // Select potential decorative elements
        const decorativeElements = document.querySelectorAll('span, svg, i');

        decorativeElements.forEach(element => {
            // Skip elements with meaningful text or other roles
            if (!element.textContent.trim() && !element.hasAttribute('role')) {
                // Add role="presentation"
                element.setAttribute('role', 'presentation');
            }
        });
    }

    // Run on page load
    document.addEventListener('DOMContentLoaded', handleDecorativeElements);

    function enhanceLandmarks() {
        // Identify main content
        const mainCandidates = document.querySelectorAll('[id*="main"], [class*="main"], [data-flexi-id]');
        mainCandidates.forEach(element => {
            if (element.tagName.toLowerCase() !== 'main') {
                element.setAttribute('role', 'main');
                element.setAttribute('aria-label', 'Main Content');
            }
        });

        // Identify footer
        const footerCandidates = document.querySelectorAll('[id*="footer"], [class*="footer"]');
        footerCandidates.forEach(element => {
            if (element.tagName.toLowerCase() !== 'footer') {
                element.setAttribute('role', 'contentinfo');
                element.setAttribute('aria-label', 'Footer');
            }
        });
    }

    // Run the script on page load
    document.addEventListener('DOMContentLoaded', enhanceLandmarks);

    function updateImageAltText() {
        const images = document.querySelectorAll('img');

        images.forEach(image => {
            if (!image.hasAttribute('alt') || image.alt.trim() === '') {
                // Generate a descriptive alt text based on the src or other available attributes
                const srcParts = image.src.split('/');
                const imageName = srcParts[srcParts.length - 1].replace(/\.[^/.]+$/, '').replace(/_/g, ' ');

                image.alt = `Image of ${imageName.trim()}`;
            }
        });
    }

    // Run the script on page load
    function enhanceButtonAccessibility() {
        const buttons = document.querySelectorAll('button');

        buttons.forEach(button => {
            // Handle navigation buttons
            if (button.classList.contains('owl-prev')) {
                button.setAttribute('aria-label', 'Previous slide');
            } else if (button.classList.contains('owl-next')) {
                button.setAttribute('aria-label', 'Next slide');
            }

            // Handle dot indicators
            if (button.classList.contains('owl-dot')) {
                if (button.classList.contains('active')) {
                    button.setAttribute('aria-label', 'Active slide indicator');
                } else {
                    button.setAttribute('aria-label', 'Slide indicator');
                }
            }

            // Ensure icons are hidden from screen readers
            const icons = button.querySelectorAll('i');
            icons.forEach(icon => icon.setAttribute('aria-hidden', 'true'));

            // Debugging log to verify changes in the console
            console.log(`Enhanced button: ${button.outerHTML}`);
        });
    }

    // Retry function in case the DOM changes dynamically
    function monitorDOMChanges() {
        const observer = new MutationObserver(() => {
            enhanceButtonAccessibility();
        });

        observer.observe(document.body, {
            childList: true,
            subtree: true
        });
    }

    // Run the script on initial page load
    document.addEventListener('DOMContentLoaded', () => {
        enhanceButtonAccessibility();
        monitorDOMChanges();
    });


    // Function to update alt text dynamically
    function updateImageAltText() {
        // Loop through all images on the page
        const images = document.querySelectorAll('img');

        // Iterate over each image
        images.forEach((img) => {
            // Check if the image has a src attribute
            if (img.src) {
                // Example logic to set alt text based on the image's src or other criteria
                if (img.src.includes("HighSociety_3x3_DieCut_Stickers_03_1.png")) {
                    img.alt = "HighSociety 3x3 DieCut Stickers featuring vibrant designs and logo";
                } else if (img.src.includes("img.webp")) {
                    img.alt = "Image showcasing a product or design with detailed graphics and text";
                } else if (img.src.includes("img1.webp")) {
                    img.alt = "A smaller image featuring design elements or graphics, possibly part of a larger series";
                } else {
                    // Set a generic alt text if no specific match is found
                    img.alt = "Image related to the content on the page";
                }
            }
        });
    }

    // Call the function to apply alt text updates
    updateImageAltText();
    // Function to enhance accessibility for links opening in new tabs or windows
    function enhanceLinkAccessibility() {
        // Select all anchor tags on the page
        const links = document.querySelectorAll('a[href]');

        links.forEach(link => {
            // Check if the link has a target attribute set to "_blank"
            if (link.target === '_blank') {
                // If there's already an aria-label, preserve it
                const existingAriaLabel = link.getAttribute('aria-label');
                const newLabel = existingAriaLabel ?
                    `${existingAriaLabel}. Opens in a new tab.` :
                    'Opens in a new tab.';

                // Add or update the aria-label attribute
                link.setAttribute('aria-label', newLabel);

                // Add a visually hidden element for screen readers if needed
                if (!link.querySelector('.sr-only')) {
                    const srOnlyElement = document.createElement('span');
                    srOnlyElement.className = 'sr-only';
                    srOnlyElement.textContent = ' (opens in a new tab)';
                    srOnlyElement.style.position = 'absolute';
                    srOnlyElement.style.clip = 'rect(1px, 1px, 1px, 1px)';
                    srOnlyElement.style.clipPath = 'inset(50%)';
                    srOnlyElement.style.height = '1px';
                    srOnlyElement.style.width = '1px';
                    srOnlyElement.style.overflow = 'hidden';
                    link.appendChild(srOnlyElement);
                }
            }
        });
    }

    // Run the function on page load
    document.addEventListener('DOMContentLoaded', enhanceLinkAccessibility);

    // Function to enhance accessibility for visually styled headings
    function enhanceHeadingAccessibility() {
        // Select all elements that visually function as headings but are not semantic headings
        const potentialHeadings = document.querySelectorAll('.title, .subtitle');

        potentialHeadings.forEach(element => {
            // Check if the element is not already a semantic heading
            if (!/^H[1-6]$/.test(element.tagName)) {
                // Determine the heading level (default to 2 if no specific class)
                const headingLevel = element.classList.contains('subtitle') ? 3 : 2;

                // Add ARIA role and level if not already present
                if (!element.hasAttribute('role')) {
                    element.setAttribute('role', 'heading');
                    element.setAttribute('aria-level', headingLevel);
                }
            }
        });
    }

    // Run the function on page load
    document.addEventListener('DOMContentLoaded', enhanceHeadingAccessibility);
</script>

<script>
    // Get the elements with the 'sticky-mobile-ctas' class
    const stickyCtas = document.getElementsByClassName('sticky-mobile-ctas');
    const stickyCta = stickyCtas[0]; // Access the first (and only) element in the collection

    // Listen for scroll events
    // window.addEventListener('scroll', () => {
    //     if (window.scrollY >= 460) {
    //         stickyCta.classList.add('show'); // Add 'show' class to display the CTA
    //     } else {
    //         stickyCta.classList.remove('show'); // Remove 'show' class to hide the CTA
    //     }
    // });

    // adding hash

    document.addEventListener("DOMContentLoaded", function() {
        var heading = document.querySelector('#iinq h1');
        if (!heading) return;

        // Function to check and update heading
        function updateHeading() {
            var currentText = heading.textContent.trim();
            if (currentText === '1 Cannabis Marketing Agency That Guarantees Results') {
                heading.textContent = '#' + currentText;
                observer.disconnect(); // Stop observing once updated
            }
        }

        // Create observer to watch for text changes
        var observer = new MutationObserver(updateHeading);

        // Start observing the heading element
        observer.observe(heading, {
            childList: true,
            subtree: true
        });

        // Initial check in case text is already set
        updateHeading();
    });
</script>
    
