/* Contact Form */
.sg-section-page-banner {
    padding-top: 0;
}

.sg-section-contact-form {
    padding-top: 20vh;
}

.sg-section-contact-form .t {
    text-align: center;
}

.sg-section-contact-form .sg_contact-card .h4 {
    font-weight: 500;
}

.sg_cta-boxed {
    position: relative;
    font-family: 'Montserrat';
    display: block;
    padding: 25px 150px 25px 25px;
    width: 100%;
    color: #fff;
    background: #493372;
    /* #8B3EE6;*/
    background: linear-gradient(to right, #420F7B 9%, #8D3FE8 100%);
    box-shadow: 0 0 15px rgba(0, 0, 0, 0.5);
    /*background-image: url(/sites/sg_dispenza-7/uploads/2024/01/card_results_bg.webp);*/
    background-repeat: no-repeat;
    background-size: cover;
}

.sg_cta-boxed a {
    color: #fff !important;
}

.sg_cta-boxed:hover {
    color: #fff !important;
}

.sg_cta-boxed img.ico {
    position: absolute;
    width: auto;
    max-height: 135px;
    max-width: 135px;
    right: 25px;
    top: 0;
}

.sg_cta-boxed h4 {
    color: #fff;
    font-size: 1.9em;
    line-height: 1em;
    margin: 0;
    font-weight: 900;
}

.sg_contact-card {
    position: relative;
    padding: 25px;
    background-color: #fff;
    border: 1px solid #e3e3e3;
    box-shadow: 0 0 15px rgba(0, 0, 0, 0.5);
    min-height: 205px;
    overflow: hidden;
}

.sg_contact-card .h1,
.sg_contact-card .h2,
.sg_contact-card .h3,
.sg_contact-card .h4,
.sg_contact-card .h5,
.sg_contact-card .h6 {
    font-family: 'Montserrat';
}

.sg_contact-card>em.fa {
    position: absolute;
    top: 5%;
    right: -50px;
    font-size: 8em;
    width: 150px;
    text-align: center;
    opacity: 0.05;
    transition: all 0.35s;
}

