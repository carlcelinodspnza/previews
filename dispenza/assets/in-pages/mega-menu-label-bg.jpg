[data-flexi-id="m8h3k84npnpzm"] a.btn.btn-default {
    background: #FFFFFF;
    color: #8D3FE8;
    border-radius: 500px;
    font-size: 18px;
    border: 0px solid #fff;
    min-width: 223px;
    height: 49px;
    font-weight: 600;
}

[data-flexi-id="m8h3k84npnpzm"] .owl-theme.owl-carousel .owl-item {
    padding: 0px;
    background: transparent;
    border-radius: 10px;
    overflow: hidden;
    height: 388px
}

[data-flexi-id="m8h3k84npnpzm"] .sg-hero-slider .slider-item {
    padding: 0px 0px 0px;
    height: 100%;
}

[data-flexi-id="m8h3k84npnpzm"] .sg-hero-slider .slider-item>.inner {
    height: 100%;
    flex-direction: column-reverse;
    padding: 0px 0px 0px !important;
    /*justify-content: space-between;*/
}

[data-flexi-id="m8h3k84npnpzm"] .owl-carousel .owl-stage {
    display: flex;
    justify-content: center;
}

[data-flexi-id="m8h3k84npnpzm"] .sg-hero-slider .slider-item>.inner>.slide-content {
    flex: 0 0 auto;
    padding: 40px 0px 0px;
    /*display: flex;*/
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    text-align: center;
    height: 50%;
}

[data-flexi-id="m8h3k84npnpzm"] .sg-hero-slider .slider-item>.inner>.thumb {
    flex: 0 0 auto;
    max-width: 100%;
    height: 50%;
    display: flex;
    align-items: center;
}

[data-flexi-id="m8h3k84npnpzm"] .sg-hero-slider .slider-item>.inner>.thumb img {
    object-fit: contain;
    max-width: 175px;
    width: auto;
    margin: 0px auto;
}

[data-flexi-id="m8h3k84npnpzm"] .heading {
    font-size: 13px;
    color: white;
    font-weight: 600;
}

[data-flexi-id="m8h3k84npnpzm"] .caption {
    font-size: 24px;
    font-weight: 700;
    color: white;
}

[data-flexi-id="m8h3k84npnpzm"] .sg-hero-slider .slider-item>.inner .ctas {
    margin-top: 25px;
}

@media screen and (min-width:1800px) {
    [data-flexi-id="m8h3k84npnpzm"] .owl-theme.owl-carousel .owl-item {
        width: 456px !important;
    }
}

@media screen and (min-width:768px) and (max-width:1700px) {
    [data-flexi-id="m8h3k84npnpzm"] .heading {
        font-size: 13px;
        margin-bottom: 0px;
    }

    [data-flexi-id="m8h3k84npnpzm"] .caption {
        font-size: 14px;
    }

    [data-flexi-id="m8h3k84npnpzm"] .btn.btn-default {
        padding: 25px 30px !important;
    }
}

[data-flexi-id="m8h3k84npnpzm"] .owl-theme.owl-carousel .owl-dots .owl-dot span {
    width: 18px;
    height: 18px;
    background-color: transparent;
    border: 1px solid #000;
}

[data-flexi-id="m8h3k84npnpzm"] .owl-theme.owl-carousel .owl-dots .owl-dot.active span {
    background-color: #000;
}

[data-flexi-id="m8h3k84npnpzm"] .owl-theme.owl-carousel .owl-dots {
    margin-top: 45px !important;
}



@media screen and (max-width:768px) {
    [data-flexi-id="m8h3k84npnpzm"] .sg-hero-slider .slider-item>.inner>.slide-content {
        padding: 20px 0px 20px;
    }

    [data-flexi-id="m8h3k84npnpzm"] a.btn.btn-default {

        padding: 25px 19px;

        font-size: 21px;
    }

    [data-flexi-id="m8h3k84npnpzm"] .heading {
        font-size: 14px;
    }

    [data-flexi-id="m8h3k84npnpzm"] .sg-hero-slider .slider-item>.inner .ctas {
        margin-top: 0px;
        position: absolute;
        width: 100%;
        left: 50%;
        top: 126px;
        transform: translateX(-50%);
    }
}

@media screen and (max-width:500px) {
    [data-flexi-id="m8h3k84npnpzm"] .sg-hero-slider .slider-item {
        max-width: 365px;
        padding: 10px 20px 5px;
        height: 100%;
        margin: 0px auto;
        overflow: hidden;
        border-radius: 15px;
    }
}

